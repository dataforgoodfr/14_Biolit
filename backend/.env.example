# Biolit API
BIOLIT_API_URL=https://biolit.fr/wp-json/biolit/v1/observations?token=change-me

# PostgreSQL
# Local/legacy name. On Clever Cloud, POSTGRESQL_ADDON_URI is injected by the
# linked PostgreSQL add-on and is used automatically when POSTGRES_URL is empty.
POSTGRES_URL=postgresql://biolit:change-me@localhost:5432/biolit
# POSTGRESQL_ADDON_URI=

# Object storage
BIOLIT_S3_BUCKET=biolit-uploads
DORIS_S3_KEY=doris_data.csv

# Clever Cloud Cellar injects these variables when the add-on is linked.
# CELLAR_ADDON_HOST=
# CELLAR_ADDON_KEY_ID=
# CELLAR_ADDON_KEY_SECRET=

# Local/Scaleway-compatible S3 fallback.
# S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=fr-par
# S3_VERIFY_SSL=true

# Label Studio
LABEL_STUDIO_URL=https://biolit-label-studio.cleverapps.io
LABEL_STUDIO_API_KEY_DATAFORGOOD=change-me
LABEL_STUDIO_CROPS_PROJECT=Biolit Crops
LABEL_STUDIO_NO_CROPS_PROJECT=Biolit No Crops
LABEL_STUDIO_PRESIGNED_URL_EXPIRES=604800
LABEL_STUDIO_HOST=https://biolit-label-studio.cleverapps.io
DJANGO_DB=default
POSTGRE_NAME=labelstudio
POSTGRE_USER=labelstudio
POSTGRE_PASSWORD=change-me
POSTGRE_HOST=
POSTGRE_PORT=5432

# Clever Cloud Docker apps
# Ingestion Task:
# CC_RUN_COMMAND=uv run python -m pipelines.run
#
# Label Studio app:
# CC_DOCKERFILE=infra/label-studio/Dockerfile
#
# Metabase app:
# CC_DOCKERFILE=infra/metabase/Dockerfile
# MB_JETTY_PORT=8080
# MB_DB_TYPE=postgres
# MB_DB_HOST=
# MB_DB_PORT=5432
# MB_DB_DBNAME=metabase
# MB_DB_USER=
# MB_DB_PASS=
